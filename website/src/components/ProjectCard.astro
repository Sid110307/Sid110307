---
import type { Project, ProjectArea } from "../data/projects";

interface Props {
	project: Project;
	area?: ProjectArea;
}

const { project, area } = Astro.props as Props;
---

<article class="project-card" data-project-item={area ? "true" : undefined} data-area={area}>
    <h3 class="project-card__title">
        <a href={project.url}>{project.name}</a>
    </h3>
    <p class="project-card__description">{project.description}</p>
    {project.technologies?.length ? (
        <ul class="tag-list" aria-label={`${project.name} technologies`}>
            {project.technologies.map((technology) => (
                <li class="tag">{technology}</li>
            ))}
        </ul>
    ) : null}
</article>
