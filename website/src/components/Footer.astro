---
import SocialIcon from "../components/Social";
import { LICENSE, SOCIAL_LINKS } from "../data/site";
---

<footer class="site-footer">
    <div class="site-shell site-footer__inner">
        <p>{LICENSE}</p>
        <ul class="site-footer__links" aria-label="Social links">
			{SOCIAL_LINKS.map((link) => (
                    <li class="site-footer__link">
                        <a href={link.url} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                            <SocialIcon label={link.label} />
                            {link.label}
                        </a>
                    </li>
			))}
        </ul>
    </div>
</footer>
