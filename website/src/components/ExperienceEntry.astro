---
import type { ExperienceEntry as ExperienceEntryType } from "../data/experience";

interface Props {
	entry: ExperienceEntryType;
    current?: boolean;
}

const { entry, current = false } = Astro.props;
---

<article class:list={["timeline-entry", { "timeline-entry--current": current }]}>
    <div class="timeline-entry__marker" aria-hidden="true">
        <span class="timeline-entry__dot"></span>
    </div>
    <div class="timeline-entry__content">
        <header class="timeline-entry__header">
            <div>
                <h3 class="timeline-entry__title">
                    {entry.title}
                </h3>
                <p class="timeline-entry__organization">
                    {entry.organization}
                </p>
            </div>
            <span class="timeline-entry__date">
                {entry.date}
            </span>
        </header>
        <ul class="timeline-entry__bullets">
            {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
            ))}
        </ul>
    </div>
</article>
