---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import SocialIcon from "../components/Social";
import { AUTHOR, GITHUB_STATS, SOCIAL_LINKS, SITE_DESCRIPTION } from "../data/site";
import { PROJECTS, FEATURED_PROJECTS } from "../data/projects";
import { EXPERIENCE } from "../data/experience";
import { PUBLICATIONS } from "../data/publications";
import { withBase, getCanonicalUrl } from "../utils";

const allProjects = PROJECTS.flatMap((section) => section.projects);
const featured = FEATURED_PROJECTS.map((name) => allProjects.find((project) => project.name === name)).filter((project): project is (typeof allProjects)[number] => Boolean(project));
const firstPublication = PUBLICATIONS[0];
---

<BaseLayout title="Hey, I'm Siddharth" description={SITE_DESCRIPTION} canonical={getCanonicalUrl("/")}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Person",
		name: AUTHOR.name,
		alternateName: AUTHOR.username,
		email: AUTHOR.email,
		url: `${getCanonicalUrl("/")}`,
		sameAs: [
			"https://github.com/Sid110307",
			"https://linkedin.com/in/sid110307",
			"https://x.com/CoolorFoolSRS",
			"https://dev.to/@sid110307",
		],
	})} />
    <section class="site-shell hero">
        <div class="hero__copy">
            <div class="hero__intro">
                <h1>Hey, I&apos;m Siddharth</h1>
                <p class="hero__lede">{SITE_DESCRIPTION}</p>
            </div>
            <div class="hero__actions" aria-label="Social links">
                {SOCIAL_LINKS.map((link) => (
                        <a class="btn" href={link.url} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                            <SocialIcon label={link.label} />
                            {link.label}
                        </a>
                ))}
            </div>
        </div>
        <img class="hero__avatar"
                src={AUTHOR.avatar}
                alt={`${AUTHOR.name} avatar`}
                width="240"
                height="240"
                loading="eager"
                decoding="async" />
    </section>
    <section class="site-shell section">
        <p class="section__eyebrow">
            <a style="text-decoration: none; color: inherit;" href={withBase("/projects/")}>Featured projects</a>
        </p>
        <div class="card-grid">
			{featured.map((project) =>
                    <ProjectCard project={project} noTags />)}
        </div>
        <p><a href={withBase("/projects/")}>Browse all projects →</a></p>
    </section>
    <section class="site-shell section">
        <p class="section__eyebrow">
            <a
                class="section-link"
                href={withBase("/experience/")}
            >
                Current experience
            </a>
        </p>
        <div class="experience-timeline">
            {EXPERIENCE.map((entry, index) => (
                <ExperienceEntry
                    entry={entry}
                    current={index === 0}
                />
            ))}
        </div>
    </section>
    <section class="site-shell section">
        <p class="section__eyebrow">
            <a style="text-decoration: none; color: inherit;" href={withBase("/publications/")}>Patents /
                publications</a>
        </p>
        <div class="card-grid">
			{firstPublication ?
                    <PublicationCard publication={firstPublication} /> : null}
        </div>
    </section>
    <section class="site-shell section">
        <p class="section__eyebrow">GitHub stats</p>
        <div class="stats-grid">
			{GITHUB_STATS.map((stat) => (
                    <img style="width: 100%; height: auto; border-radius: 0.7rem; background: var(--bg-soft);"
                         src={stat.src}
                         alt={stat.alt}
                         width={stat.width}
                         height={stat.height}
                         loading="lazy"
                         decoding="async" />
			))}
        </div>
    </section>
</BaseLayout>
