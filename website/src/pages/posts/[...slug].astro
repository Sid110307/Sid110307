---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { getReadingTime } from "../../utils";

interface PostContext {
	post: CollectionEntry<"posts">;
	previousPost: CollectionEntry<"posts"> | null;
	nextPost: CollectionEntry<"posts"> | null;
}

export const getStaticPaths = async () => {
	const posts = (await getCollection("posts", ({ data }) => !data.draft))
		.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			previousPost: posts[index + 1] ?? null,
			nextPost: posts[index - 1] ?? null,
		} satisfies PostContext,
	}));
};

const { post, previousPost, nextPost } = Astro.props as PostContext;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
---

<PostLayout
        title={post.data.title}
        description={post.data.description}
        publishDate={post.data.publishDate}
        category={post.data.category}
        tags={post.data.tags}
        readingTime={readingTime}
        headings={headings}
        previousPost={previousPost}
        nextPost={nextPost}
>
    <Content />
</PostLayout>
