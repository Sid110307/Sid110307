---
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillGroup from "../components/SkillGroup.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import { SKILLS, EXPERIENCE } from "../data/experience";
import { getCanonicalUrl, slugify } from "../utils";

const description = "Skills grouped by category and a concise timeline of experience.";
---

<BaseLayout title="Experience" description={description} canonical={getCanonicalUrl("/experience/")}>
    <section class="site-shell section">
        <p class="section__eyebrow">Experience</p>
        <h1 class="section__title">Skills and experience</h1>
        <p>{description}</p>
        <section class="section">
            <h2>Skills</h2>
            <div class="card-grid" style="display: flex; flex-direction: column;">
				{SKILLS.map((group) => (
                        <div id={slugify(group.title)}>
                            <SkillGroup group={group} />
                        </div>
				))}
            </div>
        </section>
       <section class="section">
            <h2>Experience</h2>
            <div class="experience-timeline">
                {EXPERIENCE.map((entry, index) => (
                    <ExperienceEntry
                        entry={entry}
                        current={index === 0}
                    />
                ))}
            </div>
        </section>
    </section>
</BaseLayout>
